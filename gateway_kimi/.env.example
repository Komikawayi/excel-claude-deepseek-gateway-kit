# Copy and rename this file to .env, then fill values.
# Routing rule:
# - sk-kimi-* token => codingplan route via KIMI_CODING_BASE_URL (codingplan-first).
# - other sk-* token => PAYG route via KIMI_PAYG_BASE_URL fallback path.
KIMI_API_KEY=
KIMI_PAYG_BASE_URL=https://api.moonshot.cn/anthropic
KIMI_CODING_BASE_URL=https://api.kimi.com/coding/
MODEL_PRIMARY=kimi-k2.6
MODEL_FAST=kimi-k2.6
GATEWAY_PORT=8788
ALLOWED_ORIGIN=https://pivot.claude.ai
DEFAULT_MAX_TOKENS=4096

ALIAS_SONNET=claude-sonnet-4-5
ALIAS_SONNET_VERSIONED=claude-sonnet-4-5-20250929
ALIAS_OPUS=claude-opus-4-5
ALIAS_OPUS_VERSIONED=claude-opus-4-5-20251101
ALIAS_HAIKU=claude-haiku-4-5
ALIAS_HAIKU_VERSIONED=claude-haiku-4-5-20251001
